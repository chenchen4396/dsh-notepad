{
  "name": "@chenchen4396/dsh-notepad",
  "version": "0.2.0",
  "description": "随身笔记 (dsh-notepad) for the dsh web GUI: a notes & snippet library — save, search, copy and organize frequently-used notes and prompts by category, with a one-click quick access on the chat input toolbar.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenchen4396/dsh-notepad.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "notes.json",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node .smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}